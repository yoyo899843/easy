# Copy this file to .env and fill in values for this specific machine.
# .env is gitignored — safe to put real credentials in it.

# This host's own IP (not the public domain) — used to build monitor/ingress
# URLs that hit the challenge containers directly (http://<WEB_HOST>:<port>/).
WEB_HOST=192.168.0.98

# Host used for `nc`-based (raw TCP) challenge health checks. Usually the
# same machine as WEB_HOST, kept separate in case they ever diverge.
NC_HOST=192.168.0.98

# Public root domain the cloudflared tunnel is attached to, e.g. yoyo899843.work
# Used by cloudflared_conf_generator.py to build hostnames as <slug>-<platform>.<DOMAIN>.
DOMAIN=yoyo899843.work

# Label for this platform (easy/medium/hard). If omitted, both scripts fall
# back to the basename of the directory they're run from.
PLATFORM=easy

# cloudflared tunnel UUID (from `cloudflared tunnel create` / the Zero Trust
# dashboard). Used by cloudflared_conf_generator.py for the `tunnel:` and
# `credentials-file:` lines. If omitted, left as the <TUNNEL_ID> placeholder.
TUNNEL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Port CTFd listens on this host — cloudflared_conf_generator.py adds a
# ctfd-<PLATFORM>.<DOMAIN> ingress rule pointing at it. Defaults to 8000 if
# omitted. (Uptime Kuma's ingress rule is fixed at port 8001, not configurable.)
CTFD_PORT=8000

# Uptime Kuma connection info, used by upload_to_uptime_kuma.py.
KUMA_URL=http://192.168.0.98:8001
KUMA_USERNAME=yoyo
KUMA_PASSWORD=yoyo951105

# CTFd connection info, used by upload_to_ctfd.py.
CTFD_HOST=http://192.168.0.98:8000
CTFD_TOKEN=ctfd_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CTFD_WEB_HOST=192.168.0.98
CTFD_NC_HOST=192.168.0.98

# Which URL upload_to_ctfd.py writes into web challenges' connection_info:
#   external — public, through the cloudflared tunnel: http://<slug>-<PLATFORM>.<DOMAIN>
#   internal — LAN-only, straight to the container:    http://<CTFD_WEB_HOST>:<extra.port>
# Run the same upload twice with different .env files (or override this one
# flag) to publish both an internal-facing and external-facing CTFd instance.
CTFD_DEPLOY_MODE=external
